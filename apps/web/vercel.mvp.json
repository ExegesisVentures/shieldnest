{
  "version": 2,
  "name": "roll-nft-mvp",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "installCommand": "pnpm install",
  "env": {
    "NODE_ENV": "production",
    "ENVIRONMENT": "mvp",
    "MVP_MODE": "true",
    "SHOW_BETA_FEATURES": "false"
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "ENVIRONMENT": "mvp"
    }
  },
  "functions": {
    "pages/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "regions": ["iad1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/staking",
      "destination": "/portfolio",
      "permanent": false
    },
    {
      "source": "/rewards-history",
      "destination": "/portfolio",
      "permanent": false
    },
    {
      "source": "/convert",
      "destination": "/portfolio",
      "permanent": false
    },
    {
      "source": "/mint",
      "destination": "/portfolio",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
